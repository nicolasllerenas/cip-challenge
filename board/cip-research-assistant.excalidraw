   "versionNonce": 1183364968,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. Confianza antes que magia: cada afirmación muestra de qué PDF y de qué página sale.",
   "originalText": "1. Confianza antes que magia: cada afirmación muestra de qué PDF y de qué página sale.",
