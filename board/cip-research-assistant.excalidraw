   "versionNonce": 126938844,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2. Ella decide: la IA propone, la investigadora aprueba, edita o quita.",
   "originalText": "2. Ella decide: la IA propone, la investigadora aprueba, edita o quita.",
   "fontSize": 15,
   "fontFamily": 6,
