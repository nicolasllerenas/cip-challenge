  },
  {
   "id": "el00012",
   "type": "text",
   "x": 978,
   "y": 228,
   "width": 722.4000000000001,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
