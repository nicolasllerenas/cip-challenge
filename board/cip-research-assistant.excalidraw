   "versionNonce": 1214302568,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3. Lenguaje de investigadora, no de ingeniero. Nada de logs ni jerga técnica.",
   "originalText": "3. Lenguaje de investigadora, no de ingeniero. Nada de logs ni jerga técnica.",
